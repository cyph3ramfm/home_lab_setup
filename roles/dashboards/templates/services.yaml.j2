---
# For configuration options and examples, please see:
# https://gethomepage.dev/latest/configs/services

####################
#  NETWORK COLUMN
####################

- Network & Monitoring:
    - Portainer:
        href: https://{{ portainer_domain_prefix }}.{{ vault_domain }}
        icon: portainer
        server: {{ vault_device_name }}
        container: portainer

    - Pi-hole:
        href: https://{{ pihole_domain_prefix }}.{{ vault_domain }}/admin
        icon: pi-hole
        server: {{ vault_device_name }}
        container: pihole
        widget:
          type: pihole
          url: https://{{ pihole_domain_prefix }}.{{ vault_domain }}
          version: 6
          key: {{ vault_homepage_services_pihole_widget_key }}

    - Putty:
        href: https://{{ putty_domain_prefix }}.{{ vault_domain }}
        icon: putty
        server: {{ vault_device_name }}
        container: putty

    - Traefik:
        href: https://{{ traefik_domain_prefix }}.{{ vault_domain }}
        icon: traefik
        server: {{ vault_device_name }}
        container: traefik

    - Uptime Kuma:
        href: https://{{ uptime_kuma_domain_prefix }}.{{ vault_domain }}
        icon: uptime-kuma
        server: {{ vault_device_name }}
        container: uptime-kuma
        widget:
          type: uptimekuma
          url: https://{{ uptime_kuma_domain_prefix }}.{{ vault_domain }}
          slug: homepage

    - Glances:
        href: https://{{ glances_domain_prefix }}.{{ vault_domain }}
        icon: glances
        server: {{ vault_device_name }}
        container: glances

    - Wireguard:
        href: https://{{ wg_domain_prefix }}.{{ vault_domain }}
        icon: wireguard
        server: {{ vault_device_name }}
        container: wireguard


####################
# DEV & MULTIMEDIA TOOLS
####################

- Dev & Multimedia Tools:
    - VS Code Server:
        href: https://{{ vs_code_server_domain_prefix }}.{{ vault_domain }}
        icon: https://upload.wikimedia.org/wikipedia/commons/thumb/9/9a/Visual_Studio_Code_1.35_icon.svg/1024px-Visual_Studio_Code_1.35_icon.svg.png
        server: {{ vault_device_name }}
        container: vs_code_server

    - IT Tools:
        href: https://{{ it_tools_domain_prefix }}.{{ vault_domain }}
        icon: it-tools
        server: {{ vault_device_name }}
        container: it-tools
